# syntax=docker/dockerfile:1
# Build context: repository root. Targets: platform-core, example-capability, dev-idp.
FROM rust:1.97-bookworm AS build
WORKDIR /src
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates ./crates
COPY services ./services
COPY tools ./tools
COPY migrations ./migrations
COPY contracts ./contracts
RUN --mount=type=cache,target=/usr/local/cargo/registry --mount=type=cache,target=/src/target \
    cargo build --release --locked -p platform-core -p example-capability -p dev-idp \
 && mkdir /out && cp target/release/platform-core target/release/example-capability target/release/dev-idp /out/

FROM debian:bookworm-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --uid 10001 --no-create-home midgard
COPY deployments/docker/idp-env.sh /usr/local/bin/with-idp-env
USER 10001

FROM runtime AS platform-core
COPY --from=build /out/platform-core /usr/local/bin/platform-core
ENTRYPOINT ["/usr/local/bin/platform-core"]
CMD ["serve"]

FROM runtime AS example-capability
COPY --from=build /out/example-capability /usr/local/bin/example-capability
ENTRYPOINT ["/usr/local/bin/example-capability"]

FROM runtime AS dev-idp
COPY --from=build /out/dev-idp /usr/local/bin/dev-idp
ENTRYPOINT ["/usr/local/bin/dev-idp"]
