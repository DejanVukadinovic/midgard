# Copy to .env (git-ignored). NON-SECRET configuration only; credentials live in deployments/compose/.secrets/.
COMPOSE_PROJECT_NAME=midgard

# Pinned image versions (tags). Pin digests before any non-local use: see docs/operations/deployment.md
POSTGRES_IMAGE=postgres:16.4-bookworm
TRAEFIK_IMAGE=traefik:v3.1.6
ZITADEL_IMAGE=ghcr.io/zitadel/zitadel:v2.71.8

# Identity provider seen by core/services. Default: ZITADEL (profile `zitadel`). Its issuer is its Compose DNS name:
# ZITADEL routes by Host, so services (and the tests) must use exactly this URL.
IDP_ISSUER=http://zitadel:8080
IDP_TOKEN_URL=http://zitadel:8080/oauth/v2/token
# ZITADEL signs JWT access tokens with `typ: JWT`; see docs/operations/zitadel.md.
PLATFORM_ACCEPT_JWT_TYP=true
# Offline alternative (no ZITADEL): COMPOSE_PROFILES=dev-idp with
#   IDP_ISSUER=http://dev-idp:9000  IDP_TOKEN_URL=http://dev-idp:9000/oauth/v2/token  PLATFORM_ACCEPT_JWT_TYP=false

# Platform
PLATFORM_AUDIENCE=midgard-core
PLATFORM_OPERATOR_SUBJECTS=operator-1
PLATFORM_PUBLISHER_SUBJECTS=publisher-1=platform.|example.|examples.
REGISTRY_HEALTH_CHECK_INTERVAL_SECONDS=10
REGISTRY_RESOLUTION_TTL_SECONDS=300
RUST_LOG=info

# --- v0.2 fixtures -------------------------------------------------------------------------
# Profiles started by a plain `docker compose up`: zitadel = real ZITADEL (default); dev-idp = offline development IdP.
COMPOSE_PROFILES=zitadel
# Pinned like the other images; pin digests before any non-local use.
NATS_IMAGE=nats:2.10.22-alpine
