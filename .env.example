# Copy to .env (git-ignored). NON-SECRET configuration only; credentials live in deployments/compose/.secrets/.
COMPOSE_PROJECT_NAME=midgard

# Pinned image versions (tags). Pin digests before any non-local use: see docs/operations/deployment.md
POSTGRES_IMAGE=postgres:16.4-bookworm
TRAEFIK_IMAGE=traefik:v3.1.6
ZITADEL_IMAGE=ghcr.io/zitadel/zitadel:v2.66.4

# Identity provider seen by core/services. dev-idp profile default shown; for ZITADEL see docs/operations/zitadel.md
IDP_ISSUER=http://dev-idp:9000
IDP_TOKEN_URL=http://dev-idp:9000/oauth/v2/token

# Platform
PLATFORM_AUDIENCE=midgard-core
PLATFORM_OPERATOR_SUBJECTS=operator-1
PLATFORM_PUBLISHER_SUBJECTS=publisher-1=platform.|example.|examples.
REGISTRY_HEALTH_CHECK_INTERVAL_SECONDS=10
REGISTRY_RESOLUTION_TTL_SECONDS=300
RUST_LOG=info

# --- v0.2 fixtures -------------------------------------------------------------------------
# Profiles started by a plain `docker compose up`: dev-idp = offline development IdP.
COMPOSE_PROFILES=dev-idp
# Pinned like the other images; pin digests before any non-local use.
NATS_IMAGE=nats:2.10.22-alpine
